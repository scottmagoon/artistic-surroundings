<div id="lightbox" role="dialog" aria-modal="true" aria-label="Painting viewer">
  <div class="lb-bar">
    <button class="lb-btn" id="lb-close" type="button">Close ✕</button>
  </div>
  <button class="lb-nav lb-prev" id="lb-prev" type="button" aria-label="Previous painting">‹</button>
  <div class="lb-stage" id="lb-stage"></div>
  <button class="lb-nav lb-next" id="lb-next" type="button" aria-label="Next painting">›</button>
  <div class="lb-counter" id="lb-counter" aria-live="polite"></div>
</div>

<script>
  const lightbox = document.getElementById("lightbox") as HTMLElement;
  const stage = document.getElementById("lb-stage") as HTMLElement;
  const closeBtn = document.getElementById("lb-close") as HTMLButtonElement;
  const prevBtn = document.getElementById("lb-prev") as HTMLButtonElement;
  const nextBtn = document.getElementById("lb-next") as HTMLButtonElement;
  const counter = document.getElementById("lb-counter") as HTMLElement;

  let groupButtons: HTMLButtonElement[] = [];
  let index = 0;
  let lastFocused: HTMLElement | null = null;
  let scale = 1;
  let pinchStartDist = 0;
  let pinchStartScale = 1;
  let touchStartX = 0;
  let touchStartY = 0;
  let touchTracking: "swipe" | "pinch" | null = null;

  function focusableElements(): HTMLElement[] {
    return Array.from(lightbox.querySelectorAll<HTMLElement>("button, a[href]")).filter(
      (el) => el.offsetParent !== null
    );
  }

  function resetZoom() {
    scale = 1;
    const media = stage.querySelector<HTMLElement>("picture, img");
    if (media) media.style.transform = "";
  }

  function render() {
    const btn = groupButtons[index];
    const figure = btn.closest("figure.frame");
    const template = figure?.querySelector<HTMLTemplateElement>("template[data-lightbox-template]");
    stage.innerHTML = "";
    if (template) stage.appendChild(template.content.cloneNode(true));
    resetZoom();
    counter.textContent = `${index + 1} / ${groupButtons.length}`;
  }

  function open(group: string, startIndex: number, trigger: HTMLElement) {
    groupButtons = Array.from(
      document.querySelectorAll<HTMLButtonElement>(`.frame-button[data-lightbox-group="${CSS.escape(group)}"]`)
    ).sort((a, b) => Number(a.dataset.lightboxIndex) - Number(b.dataset.lightboxIndex));
    index = startIndex;
    lastFocused = trigger;
    lightbox.classList.add("open");
    document.body.style.overflow = "hidden";
    render();
    closeBtn.focus();
    document.addEventListener("keydown", onKeydown);
  }

  function close() {
    lightbox.classList.remove("open");
    document.body.style.overflow = "";
    stage.innerHTML = "";
    document.removeEventListener("keydown", onKeydown);
    lastFocused?.focus();
  }

  function step(delta: number) {
    index = (index + delta + groupButtons.length) % groupButtons.length;
    render();
  }

  function onKeydown(e: KeyboardEvent) {
    if (e.key === "Escape") {
      close();
    } else if (e.key === "ArrowLeft") {
      step(-1);
    } else if (e.key === "ArrowRight") {
      step(1);
    } else if (e.key === "Tab") {
      const focusable = focusableElements();
      if (focusable.length === 0) return;
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    }
  }

  document.addEventListener("click", (e) => {
    const trigger = (e.target as HTMLElement).closest<HTMLButtonElement>(".frame-button");
    if (trigger) {
      const group = trigger.dataset.lightboxGroup!;
      const idx = Number(trigger.dataset.lightboxIndex);
      open(group, idx, trigger);
    }
  });

  closeBtn.addEventListener("click", close);
  prevBtn.addEventListener("click", () => step(-1));
  nextBtn.addEventListener("click", () => step(1));

  lightbox.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;
    if (!target.closest("picture, img, button, a")) close();
  });

  // ---- touch: swipe to navigate, pinch to zoom ----
  function touchDistance(touches: TouchList) {
    const [a, b] = [touches[0], touches[1]];
    return Math.hypot(a.clientX - b.clientX, a.clientY - b.clientY);
  }

  stage.addEventListener(
    "touchstart",
    (e) => {
      if (e.touches.length === 2) {
        touchTracking = "pinch";
        pinchStartDist = touchDistance(e.touches);
        pinchStartScale = scale;
      } else if (e.touches.length === 1) {
        touchTracking = "swipe";
        touchStartX = e.touches[0].clientX;
        touchStartY = e.touches[0].clientY;
      }
    },
    { passive: true }
  );

  stage.addEventListener(
    "touchmove",
    (e) => {
      if (touchTracking === "pinch" && e.touches.length === 2) {
        e.preventDefault();
        const dist = touchDistance(e.touches);
        scale = Math.min(4, Math.max(1, pinchStartScale * (dist / pinchStartDist)));
        const media = stage.querySelector<HTMLElement>("picture, img");
        if (media) media.style.transform = `scale(${scale})`;
      }
    },
    { passive: false }
  );

  stage.addEventListener(
    "touchend",
    (e) => {
      if (touchTracking === "swipe" && scale <= 1.05 && e.changedTouches.length === 1) {
        const dx = e.changedTouches[0].clientX - touchStartX;
        const dy = e.changedTouches[0].clientY - touchStartY;
        if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy)) {
          step(dx < 0 ? 1 : -1);
        }
      }
      touchTracking = null;
    },
    { passive: true }
  );
</script>
